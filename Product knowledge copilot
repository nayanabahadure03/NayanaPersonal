function inspectTrace(historyId) {
  if (!guard("ops")) return;

  const history = state.history.find(item => item.id === historyId);
  if (!history) return;

  const selected = history.refs.map((reference, index) => {
    const resolved = resolve(reference);

    return {
      citation: index + 1,
      documentId: reference.documentId,
      chunkId: reference.chunkId,
      parentId: reference.parentId,
      keywordMatches: reference.exact,
      synonymMatches: reference.semantic,
      fusionScore: Number(reference.fused.toFixed(5)),
      passage: resolved
        ? resolved.c.text
        : "Source no longer available"
    };
  });

  modal(
    "Request trace",
    `
