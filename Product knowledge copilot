function inspect(documentId, chunkId) {
  const document = getDoc(documentId);

  if (
    !document ||
    document.deletion !== "active" ||
    (
      !eligible(document) &&
      role !== "admin" &&
      role !== "evaluator"
    )
  ) {
    modal(
      "Source no longer available",
      "<p>This source is unavailable in your current view.</p>"
    );
    return;
  }

  const passage = document.chunks?.find(
    item => item.id === chunkId
  );

  const parent = passage && document.parents.find(
    item => item.id === passage.parentId
  );

  modal(
    document.title,
    `
      <p class="small muted">${facts(document)}</p>
      <div class="row">
        ${tag(document.status)}
        ${document.fixture ? tag("Fictional example") : ""}
