async function upload(form) {
  if (!guard("admin") || busy) return;

  const file = $("#file").files[0];
  const pasted = $("#text").value.trim();

  if (file && pasted) {
    toast("Choose a file or paste text, not both.");
    return;
  }

  if (!file && !pasted) {
    toast("Choose a file or paste some document text.");
    return;
  }

  if (file && (file.size === 0 || file.size > MAX_FILE)) {
    toast(
      "The file must contain data and be no larger than 1 MB in this simulator."
    );
    return;
  }

  const extension = file
    ? file.name.split(".").pop().toLowerCase()
    : "txt";

  if (!["txt", "md", "markdown", "pdf", "docx"].includes(extension)) {
    toast("Unsupported format. Use TXT or Markdown for working text ingestion.");
    return;
  }

  if (
    file &&
    (/[\\/]/.test(file.name) || file.name.includes(".."))
  ) {
    toast("Use a filename without path characters or consecutive dots.");
    return;
  }

  if (
    file &&
    ["txt", "md", "markdown"].includes(extension) &&
    file.type &&
    !/^(text\/|application\/(octet-stream|x-empty))/.test(file.type)
  ) {
    toast("File type does not match a supported text document.");
    return;
  }

  const fields = new FormData(form);
  busy = true;
  form.querySelector("button[type=submit],button.primary").disabled = true;

  try {
    let text = pasted;
    const unsupported = ["pdf", "docx"].includes(extension);

    if (file && !unsupported) {
      const bytes = await file.arrayBuffer();
      text = new TextDecoder("utf-8", { fatal: true })
        .decode(bytes)
        .trim();

      if (
        !text ||
        text.includes("\u0000") ||
        text.startsWith("%PDF-") ||
        text.startsWith("PK\u0003\u0004")
      ) {
        throw Error("invalid");
      }
    }

    if (
      !unsupported &&
      state.docs.some(
        document =>
          document.deletion === "active" &&
          document.text === text
      )
    ) {
      toast("Duplicate text already exists. Upload a changed version instead.");
      return;
    }

    const document = {
      id: uid(),
      title: String(
        fields.get("title") ||
        file?.name ||
        "Pasted document"
      ).trim(),
      filename: file?.name || "pasted-document.txt",
      text,
      created: now(),
      uploader: "Local Admin preview",
      status: "uploaded",
      deletion: "active",
      indexed: false,
      parents: [],
      chunks: [],
      applicability: String(fields.get("applicability")),
      replaces: String(fields.get("replaces") || ""),
      fixture: false
    };

    for (const [key] of metaFields) {
      document[key] = String(fields.get(key) || "").trim();
    }

    state.docs.push(document);
    save();

    if (unsupported) {
      document.status = "processing_failed";
      document.error =
        "This simulator has no PDF/DOCX parser or OCR. " +
        "Export the document as UTF-8 TXT/Markdown and upload it. " +
        "No text was indexed.";

      save();

      toast(
        "File recorded, but parsing is unavailable. No knowledge was published."
      );

      page = "manage";
      location.hash = "manage";
    } else {
      await processDoc(document);
    }
  } catch {
    toast(
      "The document could not be read as UTF-8 text. Try a valid TXT or Markdown file."
    );
  } finally {
    busy = false;
    render();
  }
}

async function processDoc(document) {
  if (document.deletion !== "active") return;

  document.status = "processing";
  document.error = "";
  save();

  const stages = [
    "Parse text and headings",
    "Create parent / child passages",
    "Prepare local search index",
    "Await human evaluation"
  ];

  for (let index = 0; index < stages.length; index++) {
    if (document.deletion !== "active") return;

    ingest = { id: document.id, stage: index };

    const target = $("#uploadStatus");

    if (target) {
      target.innerHTML = `
        <progress class="progress" value="${index}" max="4"></progress>
        <p>${stages[index]}</p>
      `;
    }

    await wait(180);
  }

  if (document.deletion !== "active") return;

  const parsed = chunk(document.text, document.id);
  document.parents = parsed.parents;
  document.chunks = parsed.chunks;
  document.indexed = !!document.chunks.length;
  document.status = document.indexed
    ? "awaiting_evaluation"
    : "processing_failed";

  ingest = null;
  save();

  toast(
    "Processing complete. Switch to Evaluator / Approver to review and approve."
  );

  page = "manage";
  location.hash = "manage";
}

