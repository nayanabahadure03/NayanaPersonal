function review(documentId, approved) {
  if (!guard("evaluator")) return;

  const document = getDoc(documentId);

  if (!document || document.deletion !== "active") return;

  if (approved && !$("#reviewed")?.checked) {
    toast("Review the content and confirm the checkbox first.");
    return;
  }

  if (approved && (!document.indexed || !document.chunks.length)) {
    return;
  }

  document.status = approved ? "approved" : "rejected";

  if (approved && document.replaces) {
    const previous = getDoc(document.replaces);

    if (
      previous &&
      previous.id !== document.id &&
      previous.deletion === "active"
    ) {
      previous.applicability = "historical";
    }
  }

  save();
  $("#dialog").close();
  render();

  toast(
    approved
      ? "Approved. This document is now available in Sources and search."
      : "Rejected. This document remains excluded from consumer retrieval."
  );
}

