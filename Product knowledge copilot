const stop=new Set("a an the how what does do is are was were can could should would i we you it this that those these of to in for and or on with from about tell me please explain work works current currently previous historical changed change feature functionality behaviour behavior which source sources answer information available get has have been did".split(" "));
const tokens=t=>[...new Set((String(t).toLowerCase().match(/[\p{L}\p{N}_-]+/gu)||[]).filter(x=>x.length>1&&!stop.has(x)))];
const aliases={authorize:"review",authorise:"review",approval:"review",approve:"review",approver:"reviewer",validate:"review",validation:"review",download:"export",exporting:"export",phases:"stages",phase:"stages"};
const normalize=a=>[...new Set(a.map(x=>aliases[x]||x))];
