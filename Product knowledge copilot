async function deleteDoc(documentId, fail = false) {
  if (!guard("admin") || busy) return;

  const document = getDoc(documentId);

  if (
    !document ||
    ["deleted", "deleting"].includes(document.deletion)
  ) return;

  document.deletion = "deleting";
  document.indexed = false;

  state.audit.unshift({
    id: uid(),
    documentId,
    actor: "Local Admin preview",
    time: now(),
    outcome: "deleting"
  });

  save();
  $("#dialog").close();
  render();
  announce("Document excluded from retrieval. Cleanup started.");

  await wait(400);

  if (getDoc(documentId) !== document) return;

  if (fail) {
    document.deletion = "deletion_failed";

    state.audit.unshift({
      id: uid(),
      documentId,
      actor: "Local Admin preview",
      time: now(),
      outcome: "cleanup_failed"
    });

    toast(
      "Cleanup failed in the simulation. The document remains excluded. Use Retry cleanup."
    );
  } else {
    document.text = "";
    document.parents = [];
    document.chunks = [];
    document.error = "";
    document.conflictGroup = "";
    document.conflictValue = "";
    document.deletion = "deleted";

    state.audit.unshift({
      id: uid(),
      documentId,
      actor: "Local Admin preview",
      time: now(),
      outcome: "deleted"
    });

    toast("Document deleted. Its passages are no longer available.");
  }

  save();
  render();
  announce(labels[document.deletion] || document.deletion);
}

