const heading=(title,sub)=>`<div class="heading"><div class="eyebrow">Product Knowledge Copilot</div><h1>${title}</h1><p style="margin-top:13px">${sub}</p></div>`;
const empty=(title,sub,action="")=>`<div class="card empty"><div class="mark" aria-hidden="true">◇</div><h2>${title}</h2><p class="muted">${sub}</p>${action}</div>`;
