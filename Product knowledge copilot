        </thead>
        <tbody>
          ${tests.map(test => `
            <tr>
              <td>${esc(test.name)}</td>
              <td>${tag(test.pass ? "PASS" : "FAIL")}</td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    `
    : '<p class="muted small">Checks have not been run.</p>';
}

function runTests() {
  if (!guard("evaluator")) return;

  const documents = fixtures();
  tests = [];

  function check(name, test) {
    let pass = false;

    try {
      pass = !!test();
    } catch {}

    tests.push({ name, pass });
  }

  check("Current feature retrieves an actual source", () =>
    decide("request review", { version: "2.0" }, documents)
      .refs.some(reference => reference.documentId === "fixture-1")
  );

  check("Table question retrieves table text", () =>
    retrieve("review stages", {}, documents)
      .some(reference =>
        resolve(reference, documents)?.c.text.includes("| Stage |")
      )
  );

  check("Related functionality stays in source text", () =>
    retrieve("audit log", {}, documents)
      .some(reference =>
        resolve(reference, documents)?.c.section === "Related functionality"
      )
  );

  check("Historical filter retrieves v1", () =>
    retrieve("request review", { version: "1.0" }, documents)
      .every(reference => reference.documentId === "fixture-2")
  );

  check("Defined synonym matches review", () =>
    retrieve("authorize", {}, documents)
      .some(reference => reference.semantic > 0 && reference.exact === 0)
  );

  check("Vague question requires clarification", () =>
    decide("How does it work?", {}, documents).status ===
      "clarification_required"
  );

  check("Unsupported topic does not invent an answer", () =>
    decide("quantum nebula", {}, documents).status ===
      "insufficient_information"
  );

  check("Explicit fixture conflict remains visible", () =>
    decide("export visibility", {}, documents).status ===
      "conflicting_sources"
  );

  check("Document instructions are inert escaped text", () =>
    esc('<script>alert(1)<\/script>').startsWith("&lt;script&gt;")
  );

  check("Citation references resolve to stored chunks", () =>
    retrieve("request review", {}, documents)
      .every(reference => !!resolve(reference, documents))
  );

  check("Unapproved sources cannot be retrieved", () => {
    const copy = structuredClone(documents);
    copy.forEach(document => document.status = "awaiting_evaluation");
    return retrieve("request review", {}, copy).length === 0;
  });

  check("Deletion failure remains excluded", () => {
    const copy = structuredClone(documents);
    copy[0].deletion = "deletion_failed";

    return !retrieve("request review", {}, copy)
      .some(reference => reference.documentId === copy[0].id);
  });

  check("Deleted references are unavailable", () => {
    const copy = structuredClone(documents);
    const reference = retrieve(
      "request review",
      { version: "2.0" },
      copy
    )[0];

    copy[0].deletion = "deleted";
    return !resolve(reference, copy);
  });

  check("Generation failure retains evidence", () => {
    const result = decide("request review", {}, documents, "generation");
    return result.status === "generation_failed" && result.refs.length > 0;
  });

  check("Reranker fallback retains evidence", () =>
    retrieve("request review", {}, documents, "reranker").length > 0
  );

  check("Unknown metadata filter returns no sources", () =>
    !retrieve(
      "request review",
      { client: "not present" },
      documents
    ).length
  );

  renderEvaluation();

  announce(
    `${tests.filter(test => test.pass).length} of ${tests.length} ` +
    "local simulator checks passed."
  );
}

document.addEventListener("submit", event => {
  if (event.target.id === "followForm") {
    event.preventDefault();
    const query = $("#follow").value;
    draft = query;
    ask(query);
  }
});

document.addEventListener("click", async event => {
  const button = event.target.closest("button");
  if (!button || button.disabled) return;

  if (button.dataset.page) {
    route(button.dataset.page);
    return;
  }

  if (button.dataset.question) {
    draft = button.dataset.question;
    $("#question").value = draft;
    $("#question").focus();
    return;
  }

  if (button.dataset.step !== undefined) {
    step = Number(button.dataset.step);
    renderGuide();
    document.querySelector(`[data-step="${step}"]`)?.focus();
    return;
  }

  const action = button.dataset.action;
  const historyId = button.dataset.id;
  const documentId = button.dataset.doc;

  try {
    switch (action) {
      case "close":
        $("#dialog").close();
        break;

      case "help":
        modal(
          "About this simulator",
          `
            <p>
              This is an offline product walkthrough,
              not the deployed production app.
            </p>
            <ol class="help-list">
              <li>
                Load fictional examples or upload non-sensitive
                TXT/Markdown as Admin.
              </li>
              <li>
                Approve new uploads as Evaluator,
                then ask questions as Consumer.
              </li>
              <li>
                Inspect evidence, history, deletion and traces
                using the role preview.
              </li>
            </ol>
            <p>
              No network requests or AI calls occur.
              Uploaded text stays in this tab's browser storage
              where available. Role switching is illustrative
              and provides no real security.
            </p>
            <button data-action="guideClose">
              Open simulator guide
            </button>
          `
        );
        break;

      case "guideClose":
        $("#dialog").close();
        route("guide");
        break;

      case "demo":
        loadDemo();
        break;

      case "clearFilters":
        filter = {};
        renderAsk();
        break;

      case "cite":
        inspect(documentId, button.dataset.chunk);
        break;

      case "document":
        inspect(documentId);
        break;

      case "openHistory":
        active = historyId;
        draft = "";
        route("ask");
        break;

      case "refine":
        draft = state.history.find(
          item => item.id === historyId
        )?.query || "";
        renderAsk();
        $("#question").focus();
        break;

      case "escalate": {
        const history = state.history.find(
          item => item.id === historyId
        );

        modal(
          "Consult PO / SME",
          `
            <p>
              Copy the question and share it through your usual
              communication channel. This simulator does not send messages.
            </p>
            <label for="escalation">Question and evidence status</label>
            <textarea id="escalation" readonly>${esc(history?.query || "")}

Status: ${esc(labels[history?.status] || "")}
Please clarify applicability and any missing source information.</textarea>
            <button
              style="margin-top:12px"
              data-action="selectEscalation"
            >Select text</button>
          `
        );
        break;
      }

      case "selectEscalation":
        $("#escalation").focus();
        $("#escalation").select();
        break;

      case "feedbackYes": {
        const history = state.history.find(
          item => item.id === historyId
        );

        history.feedback = { useful: true, time: now() };
        save();
        render();
        toast("Feedback saved.");
        break;
      }

      case "feedbackNo":
        modal(
          "What could be better?",
          `
            <label for="reason">
              Reason
              <select id="reason">
                ${[
                  "Incorrect information",
                  "Missing information",
                  "Wrong source",
                  "Outdated information",
                  "Didn't answer my question",
                  "Other"
                ].map(reason => `<option>${reason}</option>`).join("")}
              </select>
            </label>

            <label for="comment" style="margin-top:16px">
              Comment — optional
              <textarea id="comment" maxlength="1000"></textarea>
            </label>

            <div class="foot">
              <button
                class="primary"
                data-action="saveFeedback"
                data-id="${historyId}"
              >Save feedback</button>
            </div>
          `
        );
        break;

      case "saveFeedback": {
        const history = state.history.find(
          item => item.id === historyId
        );

        history.feedback = {
          useful: false,
          reason: $("#reason").value,
          comment: $("#comment").value,
          time: now()
        };

        save();
        $("#dialog").close();
        render();
        toast("Feedback saved with the request trace.");
        break;
      }

      case "applyList":
        listQuery = $("#docSearch").value;
        listState = $("#docStatus").value;
        pageNo = 1;
        renderManage();
        break;

      case "prev":
        pageNo--;
        renderManage();
        break;

      case "next":
        pageNo++;
        renderManage();
        break;

      case "delete":
        deletePrompt(documentId);
        break;

      case "confirmDelete":
        await deleteDoc(documentId, $("#failCleanup")?.checked);
        break;

      case "retryDelete":
        await deleteDoc(documentId, false);
        break;

      case "reindex":
        if (guard("admin") && !busy) {
          busy = true;

          try {
            await processDoc(getDoc(documentId));
          } finally {
            busy = false;
            render();
          }
        }
        break;

      case "review":
        reviewPrompt(documentId);
        break;

      case "approve":
        review(documentId, true);
        break;

      case "reject":
        review(documentId, false);
        break;

      case "tests":
        runTests();
        break;

      case "trace":
        inspectTrace(historyId);
        break;

      case "searchTraces":
        traceQuery = $("#traceSearch").value;
        renderObservability();
        break;

      case "resetPrompt":
        modal(
          "Clear simulator session?",
          `
            <p>
              This removes local documents, conversations and audit events
              for this simulator. It does not affect any server or repository.
            </p>
            <div class="foot">
              <button data-action="close">Cancel</button>
              <button class="danger" data-action="reset">Clear session</button>
            </div>
          `
        );
        break;

      case "reset":
        if (busy) {
          toast("Wait for processing to finish.");
          break;
        }

        state = initial();
        active = null;
        draft = "";
        filter = {};
        tests = [];
        failure = "none";

        save();
        $("#dialog").close();
        render();
        toast("Simulator session cleared.");
        break;
    }
  } catch {
    toast("This action could not be completed. Please try again.");
  }
});

$("#role").onchange = event => {
  if (busy) {
    event.target.value = role;
    toast("Wait for processing to finish before switching roles.");
    return;
  }

  role = event.target.value;
  $("#dialog").close();
  page = "ask";
  location.hash = "ask";
  render();
  announce("Preview role changed.");
};

window.addEventListener("hashchange", () => {
  page = location.hash.slice(1) || "ask";
  render();
});

window.addEventListener("error", () => {
  toast(
    "An unexpected interface error occurred. Reload to recover your saved session."
  );
});

window.addEventListener("unhandledrejection", () => {
  busy = false;
  toast(
    "An operation failed. Please retry; no raw error details are displayed."
  );
});

save();
page = location.hash.slice(1) || "ask";
render();
</script>
</body>
</html>
