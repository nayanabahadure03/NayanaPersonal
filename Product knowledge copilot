const stop = new Set(
  (
    "a an the how what does do is are was were can could should would " +
    "i we you it this that those these of to in for and or on with from " +
    "about tell me please explain work works current currently previous " +
    "historical changed change feature functionality behaviour behavior " +
    "which source sources answer information available get has have been did"
  ).split(" ")
);

function tokens(text) {
  return [
    ...new Set(
      (String(text).toLowerCase().match(/[\p{L}\p{N}_-]+/gu) || [])
        .filter(token => token.length > 1 && !stop.has(token))
    )
  ];
}

/*
This explicit synonym map is a teaching approximation.
It is not an embedding model or semantic understanding.
*/
const aliases = {
  authorize: "review",
  authorise: "review",
  approval: "review",
  approve: "review",
  approver: "reviewer",
  validate: "review",
  validation: "review",
  download: "export",
  exporting: "export",
  phases: "stages",
  phase: "stages"
};

const normalize = values =>
  [...new Set(values.map(value => aliases[value] || value))];

function chunk(text, documentId) {
  const parents = [];
  let title = "Document text";
  let lines = [];

  function flush() {
    const content = lines.join("\n").trim();

    if (content) {
      for (let index = 0; index < content.length; index += 1600) {
        parents.push({
          id: `${documentId}-p${parents.length}`,
          section: title,
          text: content.slice(index, index + 1600)
        });
      }
    }

    lines = [];
  }

  for (const line of text.replace(/\r\n?/g, "\n").split("\n")) {
    if (/^#{1,6}\s+/.test(line)) {
      flush();
      title = line.replace(/^#{1,6}\s+/, "").trim();
    } else {
      lines.push(line);
    }
  }

  flush();

  const chunks = [];

  for (const parent of parents) {
    const pieces = parent.text.split(/\n\s*\n/);

    for (const piece of pieces) {
      if (!piece.trim()) continue;

      for (let start = 0; start < piece.length; start += 650) {
        chunks.push({
          id: `${documentId}-c${chunks.length}`,
          parentId: parent.id,
          section: parent.section,
          text: piece.slice(start, start + 650).trim()
        });
      }
    }
  }

  return { parents, chunks };
}

function retrieve(query, filters, documents, fault = "none") {
  const terms = tokens(query);
  const expanded = normalize(terms);
  const rows = [];

  for (const document of documents.filter(eligible)) {
    if (
      Object.entries(filters).some(
        ([key, value]) => value && document[key] !== value
      )
    ) continue;

    for (const passage of document.chunks) {
      const words = tokens(passage.section + " " + passage.text);
      const normalized = normalize(words);

      const exact = terms.filter(term => words.includes(term)).length;
      const semantic = expanded.filter(
        term => normalized.includes(term)
      ).length;

      if (!exact && !semantic) continue;

      rows.push({
        documentId: document.id,
        chunkId: passage.id,
        parentId: passage.parentId,
        exact,
        semantic,
        coverage: semantic / Math.max(1, expanded.length)
      });
    }
  }

  const lexical = [...rows].sort((a, b) => b.exact - a.exact);
  const synonyms = [...rows].sort((a, b) => b.semantic - a.semantic);

  rows.forEach(row => {
    row.fused =
      (row.exact ? 1 / (60 + lexical.indexOf(row) + 1) : 0) +
      (row.semantic ? 1 / (60 + synonyms.indexOf(row) + 1) : 0);
  });

  rows.sort((a, b) =>
    fault === "reranker"
      ? b.fused - a.fused
      : b.coverage - a.coverage || b.fused - a.fused
  );

  const seen = new Set();

  return rows.filter(row => {
    const document = documents.find(item => item.id === row.documentId);
    const passage = document.chunks.find(item => item.id === row.chunkId);
    const key = document.id + "|" + passage.text;

    if (seen.has(key)) return false;

    seen.add(key);
    return true;
  }).slice(0, 6);
}

function decide(query, filters, documents, fault = "none") {
  const terms = tokens(query);
  let refs = [];
  let answerStatus = "answered";

  if (!terms.length) {
    answerStatus = "clarification_required";
  } else if (fault === "retrieval") {
    answerStatus = "retrieval_failed";
  } else {
    refs = retrieve(query, filters, documents, fault);

    if (!refs.length) {
      answerStatus = "insufficient_information";
    } else if (fault === "generation") {
      answerStatus = "generation_failed";
    } else if (fault === "citation") {
      answerStatus = "citation_validation_failed";
    } else {
      /*
      Conflict detection is deliberately restricted to explicit fixture
      markers. It does not claim to understand arbitrary contradictions.
      */
      const groups = new Map();

      for (const reference of refs) {
        const document = documents.find(
          item => item.id === reference.documentId
        );

        if (
          document.conflictGroup &&
          document.applicability === "current"
        ) {
          if (!groups.has(document.conflictGroup)) {
            groups.set(document.conflictGroup, new Set());
          }

          groups.get(document.conflictGroup).add(document.conflictValue);
        }
      }

      if ([...groups.values()].some(values => values.size > 1)) {
        answerStatus = "conflicting_sources";
      }
    }
  }

  return { status: answerStatus, refs };
}

async function ask(query) {
  query = query.trim();

  if (busy || !query) return;

  if (query.length > 2000) {
    toast("Please keep your question within 2,000 characters.");
    return;
  }

  busy = true;
  draft = query;
  renderAsk();

  const started = performance.now();
  const chosenFilters = structuredClone(filter);
  const selectedFault = failure;

  $("#answer").innerHTML = `
    <div class="card pending">
      <strong>Checking available sources…</strong>
      <p class="muted small">
        Only active, approved documents are eligible.
      </p>
    </div>
  `;

  announce("Searching approved sources.");
  await wait(350);

  const retrievalStarted = performance.now();

  let result = decide(
    query,
    chosenFilters,
    state.docs,
    selectedFault
  );

  const retrievalMs = Math.round(
    performance.now() - retrievalStarted
  );

  await wait(150);

  /*
  Re-evaluate against live state after the delay.
  Passage text is never cached in the history or trace.
  */
  result = decide(
    query,
    chosenFilters,
    state.docs,
    selectedFault
  );

  const record = {
    id: uid(),
    query,
    filters: chosenFilters,
    time: now(),
    role,
    status: result.status,
    refs: result.refs,
    fault: selectedFault,
    totalMs: Math.round(performance.now() - started),
    retrievalMs,
    feedback: null
  };

  state.history.unshift(record);
  active = record.id;
  state.history = state.history.slice(0, 100);

  save();
  busy = false;
  render();
  announce(labels[record.status]);
}

function resolve(reference, documents = state.docs) {
  const document = documents.find(
    item => item.id === reference.documentId
  );

  if (!eligible(document)) return null;

  const passage = document.chunks.find(
    item => item.id === reference.chunkId
  );

  return passage ? { d: document, c: passage } : null;
}

function citation(reference, index) {
  const resolved = resolve(reference);

  const title = resolved
    ? esc([
        resolved.d.title,
        resolved.c.section,
        resolved.d.version
      ].filter(Boolean).join(" · "))
    : "Source no longer available";

  return `
    <button
      class="cite"
      data-action="cite"
      data-doc="${esc(reference.documentId)}"
      data-chunk="${esc(reference.chunkId)}"
    >[${index + 1}] ${title}</button>
  `;
}

