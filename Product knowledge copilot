  ["Fictional: Export visibility — policy B","Export visibility","1.0","current","# Export visibility\nExport visibility includes external users in fictional policy B. This intentionally conflicts with fictional policy A for the same scope.","visibility","external"]
 ];
 return definitions.map((a,i)=>{const d={id:"fixture-"+(i+1),title:a[0],feature:a[1],version:a[2],applicability:a[3],text:a[4],conflictGroup:a[5]||"",conflictValue:a[6]||"",product:"Fictional demo product",client:"",jurisdiction:"",type:i===1?"Release Notes":"Product Knowledge",filename:"fictional-example-"+(i+1)+".md",created:now(),uploader:"Fictional fixture loader",status:"approved",deletion:"active",indexed:true,fixture:true};return Object.assign(d,chunk(d.text,d.id));});
}
function loadDemo(){if(state.demo){toast("Examples already loaded. Clear the simulator session to restore deleted examples.");return;}state.docs.push(...fixtures());state.demo=true;save();render();toast("Four explicitly fictional documents loaded for demonstration.");}
function testsHTML(){return tests.length?`<table><thead><tr><th>Isolated simulator check</th><th>Result</th></tr></thead><tbody>${tests.map(t=>`<tr><td>${esc(t.name)}</td><td>${tag(t.pass?"PASS":"FAIL")}</td></tr>`).join("")}</tbody></table>`:"<p class=\"muted small\">Checks have not been run.</p>";}
function runTests(){
 if(!guard("evaluator"))return;const f=fixtures();tests=[];const check=(name,fn)=>{let pass=false;try{pass=!!fn();}catch{}tests.push({name,pass});};
 check("Current feature retrieves an actual source",()=>decide("request review",{version:"2.0"},f).refs.some(r=>r.documentId==="fixture-1"));
 check("Table question retrieves table text",()=>retrieve("review stages",{},f).some(r=>resolve(r,f)?.c.text.includes("| Stage |")));
 check("Related functionality stays in source text",()=>retrieve("audit log",{},f).some(r=>resolve(r,f)?.c.section==="Related functionality"));
 check("Historical filter retrieves v1",()=>retrieve("request review",{version:"1.0"},f).every(r=>r.documentId==="fixture-2"));
 check("Defined synonym matches review",()=>retrieve("authorize",{},f).some(r=>r.semantic>0&&r.exact===0));
 check("Vague question requires clarification",()=>decide("How does it work?",{},f).status==="clarification_required");
 check("Unsupported topic does not invent an answer",()=>decide("quantum nebula",{},f).status==="insufficient_information");
 check("Explicit fixture conflict remains visible",()=>decide("export visibility",{},f).status==="conflicting_sources");
 check("Document instructions are inert escaped text",()=>esc('<script>alert(1)<\/script>').startsWith("&lt;script&gt;"));
 check("Citation references resolve to stored chunks",()=>retrieve("request review",{},f).every(r=>!!resolve(r,f)));
 check("Unapproved sources cannot be retrieved",()=>{const x=structuredClone(f);x.forEach(d=>d.status="awaiting_evaluation");return retrieve("request review",{},x).length===0;});
 check("Deletion failure remains excluded",()=>{const x=structuredClone(f);x[0].deletion="deletion_failed";return !retrieve("request review",{},x).some(r=>r.documentId===x[0].id);});
 check("Deleted references are unavailable",()=>{const x=structuredClone(f),r=retrieve("request review",{version:"2.0"},x)[0];x[0].deletion="deleted";return !resolve(r,x);});
 check("Generation failure retains evidence",()=>{const a=decide("request review",{},f,"generation");return a.status==="generation_failed"&&a.refs.length>0;});
 check("Reranker fallback retains evidence",()=>retrieve("request review",{},f,"reranker").length>0);
 check("Unknown metadata filter returns no sources",()=>!retrieve("request review",{client:"not present"},f).length);
 renderEvaluation();announce(`${tests.filter(t=>t.pass).length} of ${tests.length} local simulator checks passed.`);
}
document.addEventListener("submit",e=>{if(e.target.id==="followForm"){e.preventDefault();const q=$("#follow").value;draft=q;ask(q);}});
document.addEventListener("click",async e=>{
 const b=e.target.closest("button");if(!b||b.disabled)return;
 if(b.dataset.page){route(b.dataset.page);return;}
 if(b.dataset.question){draft=b.dataset.question;$("#question").value=draft;$("#question").focus();return;}
 if(b.dataset.step!==undefined){step=Number(b.dataset.step);renderGuide();document.querySelector(`[data-step="${step}"]`)?.focus();return;}
 const a=b.dataset.action,id=b.dataset.id,doc=b.dataset.doc;
 try{
 switch(a){
  case"close":$("#dialog").close();break;
  case"help":modal("About this simulator",`<p>This is an offline product walkthrough, not the deployed production app.</p><ol class="help-list"><li>Load fictional examples or upload non-sensitive TXT/Markdown as Admin.</li><li>Approve new uploads as Evaluator, then ask questions as Consumer.</li><li>Inspect evidence, history, deletion and traces using the role preview.</li></ol><p>No network requests or AI calls occur. Uploaded text stays in this tab's browser storage where available. Role switching is illustrative and provides no real security.</p><button data-action="guideClose">Open simulator guide</button>`);break;
  case"guideClose":$("#dialog").close();route("guide");break;
  case"demo":loadDemo();break;
  case"clearFilters":filter={};renderAsk();break;
  case"cite":inspect(doc,b.dataset.chunk);break;
  case"document":inspect(doc);break;
  case"openHistory":active=id;draft="";route("ask");break;
  case"refine":draft=state.history.find(h=>h.id===id)?.query||"";renderAsk();$("#question").focus();break;
  case"escalate":{const h=state.history.find(h=>h.id===id);modal("Consult PO / SME",`<p>Copy the question and share it through your usual communication channel. This simulator does not send messages.</p><label for="escalation">Question and evidence status</label><textarea id="escalation" readonly>${esc(h?.query||"")}\n\nStatus: ${esc(labels[h?.status]||"")}\nPlease clarify applicability and any missing source information.</textarea><button style="margin-top:12px" data-action="selectEscalation">Select text</button>`);break;}
  case"selectEscalation":$("#escalation").focus();$("#escalation").select();break;
  case"feedbackYes":{const h=state.history.find(h=>h.id===id);h.feedback={useful:true,time:now()};save();render();toast("Feedback saved.");break;}
  case"feedbackNo":modal("What could be better?",`<label for="reason">Reason<select id="reason">${["Incorrect information","Missing information","Wrong source","Outdated information","Didn't answer my question","Other"].map(v=>`<option>${v}</option>`).join("")}</select></label><label for="comment" style="margin-top:16px">Comment — optional<textarea id="comment" maxlength="1000"></textarea></label><div class="foot"><button class="primary" data-action="saveFeedback" data-id="${id}">Save feedback</button></div>`);break;
  case"saveFeedback":{const h=state.history.find(h=>h.id===id);h.feedback={useful:false,reason:$("#reason").value,comment:$("#comment").value,time:now()};save();$("#dialog").close();render();toast("Feedback saved with the request trace.");break;}
  case"applyList":listQuery=$("#docSearch").value;listState=$("#docStatus").value;pageNo=1;renderManage();break;
  case"prev":pageNo--;renderManage();break;
  case"next":pageNo++;renderManage();break;
  case"delete":deletePrompt(doc);break;
  case"confirmDelete":await deleteDoc(doc,$("#failCleanup")?.checked);break;
  case"retryDelete":await deleteDoc(doc,false);break;
  case"reindex":if(guard("admin")&&!busy){busy=true;try{await processDoc(getDoc(doc));}finally{busy=false;render();}}break;
  case"review":reviewPrompt(doc);break;
  case"approve":review(doc,true);break;
  case"reject":review(doc,false);break;
  case"tests":runTests();break;
  case"trace":inspectTrace(id);break;
  case"searchTraces":traceQuery=$("#traceSearch").value;renderObservability();break;
  case"resetPrompt":modal("Clear simulator session?","<p>This removes local documents, conversations and audit events for this simulator. It does not affect any server or repository.</p><div class=\"foot\"><button data-action=\"close\">Cancel</button><button class=\"danger\" data-action=\"reset\">Clear session</button></div>");break;
  case"reset":if(busy){toast("Wait for processing to finish.");break;}state=initial();active=null;draft="";filter={};tests=[];failure="none";save();$("#dialog").close();render();toast("Simulator session cleared.");break;
 }
 }catch{toast("This action could not be completed. Please try again.");}
});
$("#role").onchange=e=>{if(busy){e.target.value=role;toast("Wait for processing to finish before switching roles.");return;}role=e.target.value;$("#dialog").close();page="ask";location.hash="ask";render();announce("Preview role changed.");};
window.addEventListener("hashchange",()=>{page=location.hash.slice(1)||"ask";render();});
window.addEventListener("error",()=>toast("An unexpected interface error occurred. Reload to recover your saved session."));
window.addEventListener("unhandledrejection",()=>{busy=false;toast("An operation failed. Please retry; no raw error details are displayed.");});
save();page=location.hash.slice(1)||"ask";render();
</script>
