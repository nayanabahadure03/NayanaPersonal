<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Product Knowledge Copilot · Simulator</title>
<!--
Save as index.html. No dependencies, API keys, or network requests.

This previews the complete product workflow. It does not execute or certify
the specification's 15 production build steps.

A static page cannot provide backend authorisation, production RAG, or /health.

Validation: JavaScript syntax, 16 isolated checks and DOM interaction flows
passed. Real-browser layout/E2E verification was unavailable in this session.
-->
<style>
:root {
  color-scheme: light;
  --bg: #f5f7f6;
  --paper: #fff;
  --ink: #182f2d;
  --muted: #566966;
  --line: #dce5e1;
  --brand: #126b5d;
  --soft: #e7f4ee;
  --bad: #9b322e;
  --warn: #805b12;
  --shadow: 0 8px 28px #163e2c08;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font: 15px/1.6 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
button,input,select,textarea { font: inherit; }
button,a,input,select,textarea { touch-action: manipulation; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: .55; }
button,a,input,select,textarea,summary { outline-offset: 4px; }
:focus-visible { outline: 3px solid #b96a1b; }
button {
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink);
  border-radius: 9px;
  padding: 9px 14px;
  font-weight: 600;
}
button:hover:not(:disabled) {
  background: var(--soft);
  border-color: #a5c4b7;
}
.primary {
  background: var(--brand);
  border-color: var(--brand);
  color: white;
}
.primary:hover:not(:disabled) {
  background: #0b5247;
  color: white;
}
.danger { color: var(--bad); border-color: #dfb8b4; }
.small { font-size: 13px; }
.muted { color: var(--muted); }
a { color: var(--brand); }
h1,h2,h3,p { margin: 0 0 12px; }
h1 {
  font-size: clamp(25px,3vw,35px);
  line-height: 1.2;
  letter-spacing: -1px;
}
h2 { font-size: 20px; line-height: 1.35; }
h3 { font-size: 16px; }
label { display: block; font-weight: 600; font-size: 13px; }
input,select,textarea {
  width: 100%;
  border: 1px solid #bbcfc5;
  border-radius: 8px;
  padding: 10px 12px;
  background: var(--paper);
  color: var(--ink);
  margin-top: 5px;
  font-size: 15px;
  min-width: 0;
}
textarea { resize: vertical; min-height: 100px; }
input[type=checkbox] { width: auto; margin: 0 7px 0 0; }
input[type=file] { padding: 18px; border-style: dashed; }
summary { cursor: pointer; font-weight: 600; }
pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font: 13px/1.6 ui-monospace,monospace;
  background: #f1f5f3;
  padding: 16px;
  border-radius: 8px;
}
blockquote {
  margin: 12px 0;
  padding: 12px 17px;
  border-left: 3px solid #91b7a6;
  background: #f6faf7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
hr { border: 0; border-top: 1px solid var(--line); margin: 20px 0; }
[hidden] { display: none !important; }
.skip {
  position: absolute;
  top: -70px;
  left: 16px;
  z-index: 100;
  background: white;
  padding: 12px;
}
.skip:focus { top: 8px; }
.app {
  display: grid;
  grid-template-columns: 248px minmax(0,1fr);
  min-height: 100vh;
}
aside {
  padding: 30px 20px;
  background: #fff;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  font-weight: 750;
  line-height: 1.3;
}
.logo {
  background: var(--brand);
  color: white;
  padding: 11px;
  border-radius: 12px;
  font-size: 17px;
  letter-spacing: -1px;
}
.brand small {
  display: block;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: 6px;
}
nav { display: flex; flex-direction: column; gap: 5px; }
nav button {
  text-align: left;
  border-color: transparent;
  background: transparent;
  padding: 11px 12px;
  font-weight: 500;
}
nav button[aria-current=page] {
  background: var(--soft);
  color: #075648;
  font-weight: 700;
}
.side-note {
  margin-top: auto;
  border-top: 1px solid var(--line);
  padding-top: 17px;
  font-size: 12px;
  color: var(--muted);
}
.top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  align-items: center;
  padding: 17px 32px;
  border-bottom: 1px solid var(--line);
  background: #ffffffa8;
}
.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--brand);
  display: inline-block;
  margin-right: 7px;
}
.badge {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  padding: 4px 9px;
  background: var(--soft);
  border-radius: 7px;
  color: #155a46;
}
.badge.warn { background: #fff2d7; color: var(--warn); }
.badge.bad { background: #fdebea; color: var(--bad); }
.content {
  max-width: 1130px;
  margin: auto;
  padding: 36px 36px 80px;
  min-width: 0;
}
.eyebrow {
  color: var(--brand);
  font-size: 12px;
  font-weight: 750;
  letter-spacing: 1.7px;
  text-transform: uppercase;
  margin-bottom: 11px;
}
.heading { margin-bottom: 25px; }
.heading p { max-width: 730px; color: var(--muted); }
.card {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 15px;
  padding: 24px;
  box-shadow: var(--shadow);
  margin-bottom: 20px;
}
.row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.between { justify-content: space-between; }
.grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 17px;
}
.filters {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 12px;
  margin-top: 18px;
}
.notice {
  padding: 13px 16px;
  border-radius: 10px;
  background: #edf4f0;
  color: #37544a;
  margin-bottom: 18px;
  font-size: 13px;
}
.notice.warn { background: #fff4df; color: #714e0d; }
.notice.bad { background: #fff0ef; color: #942a27; }
.empty { text-align: center; padding: 36px 16px; }
.empty .mark { font-size: 27px; color: var(--brand); margin-bottom: 12px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 15px; }
.chips button { font-size: 13px; font-weight: 500; border-radius: 20px; }
.source { border-top: 1px solid var(--line); padding: 17px 0; }
.source:last-child { padding-bottom: 0; }
.source h3 { margin-bottom: 5px; }
.source p { margin-bottom: 8px; }
.cite {
  border: 0;
  background: var(--soft);
  color: var(--brand);
  font-size: 12px;
  padding: 5px 9px;
  margin: 6px 0;
  text-align: left;
}
.tablewrap { overflow: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th,td {
  text-align: left;
  border-bottom: 1px solid var(--line);
  padding: 12px 10px;
  vertical-align: top;
}
th { font-weight: 650; color: var(--muted); }
td { overflow-wrap: anywhere; }
td:first-child { min-width: 180px; }
.flow {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 8px;
  margin: 16px 0;
}
.flow div {
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 12px;
  font-size: 12px;
  background: #fafcfb;
}
.flow strong { display: block; font-size: 13px; }
.flow .done { background: var(--soft); border-color: #b1d3c2; }
.flow .now { border-color: var(--brand); background: #f1faf5; }
.step-list {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 9px;
}
.step-list button { text-align: left; font-size: 13px; }
.step-list button.active { border-color: var(--brand); background: var(--soft); }
.check {
  display: flex;
  align-items: flex-start;
  font-size: 14px;
  font-weight: 400;
}
.check input { margin-top: 5px; }
#toast {
  position: fixed;
  bottom: 18px;
  right: 18px;
  max-width: min(440px,calc(100vw - 36px));
  background: #193d32;
  color: white;
  padding: 13px 19px;
  border-radius: 12px;
  box-shadow: 0 5px 30px #0002;
  z-index: 30;
}
dialog {
  border: 1px solid var(--line);
  border-radius: 17px;
  padding: 0;
  width: min(720px,calc(100vw - 28px));
  max-height: 88vh;
  color: var(--ink);
  box-shadow: 0 24px 80px #0003;
}
dialog::backdrop { background: #12382d70; }
dialog .dialogbody { padding: 27px; overflow-wrap: anywhere; }
.dialoghead {
  position: sticky;
  top: 0;
  background: white;
  padding: 17px 23px;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.dialoghead h2 { margin: 0; }
.sr {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}
.pending { border-left: 3px solid var(--brand); padding-left: 13px; }
.toolbar { margin-bottom: 18px; }
.toolbar input { flex: 1; min-width: 150px; }
.toolbar select { width: auto; max-width: 100%; }
.status-text {
  min-height: 22px;
  margin-top: 12px;
  color: var(--muted);
  font-size: 13px;
}
.progress { width: 100%; accent-color: var(--brand); height: 10px; }
.foot { display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px; }
.help-list li { margin: 8px 0; }
.answer-section { margin-top: 24px; }
.answer-section h3 { font-size: 14px; color: var(--brand); }

@media(max-width:1000px) {
  .app { grid-template-columns: 205px minmax(0,1fr); }
  aside { padding: 24px 12px; }
  .content { padding: 28px 22px; }
  .top { padding: 16px 22px; }
  .filters,.step-list { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .flow { grid-template-columns: repeat(2,minmax(0,1fr)); }
}
@media(max-width:720px) {
  .app { display: block; }
  aside {
    border-right: 0;
    border-bottom: 1px solid var(--line);
    padding: 16px;
    gap: 14px;
  }
  .brand br { display: none; }
  nav { flex-direction: row; overflow-x: auto; }
  nav button { white-space: nowrap; flex-shrink: 0; }
  .side-note { display: none; }
  .rolebox { max-width: 100%; }
  .top { padding: 12px 16px; }
  .content { padding: 24px 16px 70px; }
  .card { padding: 19px; }
  .grid,.filters,.step-list { grid-template-columns: 1fr; }
  .heading { margin-bottom: 20px; }
  .top .muted { font-size: 12px; }
  h1 { font-size: 28px; }
  button { min-height: 42px; }
  input,textarea,select { font-size: 16px; }
  .flow { grid-template-columns: repeat(2,minmax(0,1fr)); }
}
@media(prefers-reduced-motion:reduce) {
  * { scroll-behavior: auto !important; }
}
</style>
</head>
<body>

<a href="#main" class="skip">Skip to content</a>

<div class="app">
  <aside>
    <div class="brand">
      <span class="logo" aria-hidden="true">PK</span>
      <div>
        Product Knowledge<br> Copilot
        <small>Interactive simulator</small>
      </div>
    </div>

    <nav id="nav" aria-label="Main navigation"></nav>

    <div class="rolebox">
      <label for="role">Development role preview</label>
      <select id="role">
        <option value="consumer">Consumer</option>
        <option value="admin">Uploader / Admin</option>
        <option value="evaluator">Evaluator / Approver</option>
        <option value="ops">Observability / RAG Operations</option>
      </select>
      <p class="small muted" style="margin-top:8px">
        Preview only. No real login or security boundary.
      </p>
    </div>

    <div class="side-note">
      Ask → Answer → Evidence → Context
      <br><br>
      Self-contained demo. Nothing is sent to a server.
      Use non-sensitive test documents.
    </div>
  </aside>

  <div>
    <header class="top">
      <span>
        <span class="dot" aria-hidden="true"></span>
        <strong class="small">Local simulation</strong>
      </span>
      <div class="row">
        <span id="storageLabel" class="small muted">This browser tab</span>
        <button data-action="help" class="small">How it works</button>
      </div>
    </header>

    <main id="main" class="content" tabindex="-1"></main>
  </div>
</div>

<dialog id="dialog" aria-labelledby="dialogTitle">
  <div class="dialoghead">
    <h2 id="dialogTitle"></h2>
    <button data-action="close" aria-label="Close dialog">Close</button>
  </div>
  <div id="dialogBody" class="dialogbody"></div>
</dialog>

<div id="toast" role="status" aria-live="polite" hidden></div>
<div id="live" class="sr" aria-live="polite"></div>

<noscript>
  <p>This simulator needs JavaScript enabled in your browser.</p>
</noscript>

<script>
"use strict";

const $ = s => document.querySelector(s);

const esc = value => String(value ?? "").replace(
  /[&<>"']/g,
  character => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  }[character])
);

const KEY = "pkc-simulator-v1";
const VERSION = 1;
const MAX_FILE = 1024 * 1024;

const uid = () =>
  globalThis.crypto?.randomUUID?.() ||
  "id-" + Date.now().toString(36) + Math.random().toString(36).slice(2);

const wait = milliseconds =>
  new Promise(resolve => setTimeout(resolve, milliseconds));

const now = () => new Date().toISOString();

const initial = () => ({
  version: VERSION,
  docs: [],
  history: [],
  audit: [],
  demo: false
});

let state = initial();
let stored = true;
let role = "consumer";
let page = "ask";
let busy = false;
let active = null;
let draft = "";
let filter = {};
let failure = "none";
let step = 0;
let pageNo = 1;
let listQuery = "";
let listState = "";
let traceQuery = "";
let tests = [];
let ingest = null;
let lastFocus = null;

try {
  const saved = JSON.parse(sessionStorage.getItem(KEY) || "null");

  if (
    saved &&
    saved.version === VERSION &&
    Array.isArray(saved.docs) &&
    Array.isArray(saved.history) &&
    Array.isArray(saved.audit)
  ) {
    state = saved;
  }
} catch {
  stored = false;
}

for (const document of state.docs) {
  if (document.deletion === "deleting") {
    document.deletion = "deletion_failed";
  }

  if (document.status === "processing") {
    document.status = "processing_failed";
    document.error = "Processing was interrupted. Retry ingestion.";
  }
}

function save() {
  try {
    sessionStorage.setItem(KEY, JSON.stringify(state));
    stored = true;
  } catch {
    stored = false;
  }

  $("#storageLabel").textContent = stored
    ? "Saved in this browser tab"
    : "Temporary memory only · refresh clears data";
}

function toast(message) {
  $("#toast").textContent = message;
  $("#toast").hidden = false;
  clearTimeout(toast.timer);
  toast.timer = setTimeout(() => $("#toast").hidden = true, 5500);
}

function announce(message) {
  $("#live").textContent = message;
}

function modal(title, html) {
  lastFocus = document.activeElement;
  $("#dialogTitle").textContent = title;
  $("#dialogBody").innerHTML = html;

  if (!$("#dialog").open) {
    $("#dialog").showModal();
  }
}

$("#dialog").addEventListener("close", () => {
  if (lastFocus?.isConnected) {
    lastFocus.focus();
  }
});

const metaFields = [
  ["product", "Product"],
  ["feature", "Feature / Area"],
  ["client", "Client"],
  ["jurisdiction", "Jurisdiction / Region"],
  ["version", "Version / Release"],
  ["type", "Document type"]
];

const types = [
  "Design / Requirement Document",
  "Release Notes",
  "Product Knowledge",
  "Standard / Regulatory Knowledge",
  "Accounting Knowledge"
];

const labels = {
  approved: "Approved",
  awaiting_evaluation: "Awaiting evaluation",
  uploaded: "Uploaded",
  processing: "Processing",
  processing_failed: "Processing failed",
  evaluation_failed: "Evaluation failed",
  rejected: "Rejected",
  superseded: "Superseded",
  active: "Active",
  deleting: "Deleting",
  deletion_failed: "Cleanup failed",
  deleted: "Deleted",
  answered: "Source passages found",
  clarification_required: "Clarification needed",
  insufficient_information: "Insufficient information",
  conflicting_sources: "Conflicting sources",
  generation_failed: "Generation failed",
  citation_validation_failed: "Citation validation failed",
  retrieval_failed: "Retrieval failed"
};

function tag(value) {
  const appearance = /failed|rejected|conflict/.test(value)
    ? "bad"
    : /awaiting|processing|deleting|clarification/.test(value)
      ? "warn"
      : "";

  return `<span class="badge ${appearance}">${esc(labels[value] || value)}</span>`;
}

const getDoc = id => state.docs.find(document => document.id === id);

const eligible = document =>
  !!document &&
  document.deletion === "active" &&
  document.status === "approved" &&
  document.indexed;

const can = permission =>
  permission === "consumer" || role === permission;

function guard(permission) {
  if (can(permission)) return true;

  toast(
    "Access denied in this role preview. Switch to the appropriate role."
  );

  return false;
}

function status(document) {
  return document.deletion !== "active"
    ? document.deletion
    : document.status;
}

function facts(document) {
  return [
    document.type,
    document.product,
    document.feature,
    document.version,
    document.client,
    document.jurisdiction,
    document.applicability !== "unknown"
      ? document.applicability
      : null
  ].filter(Boolean).map(esc).join(" · ");
}

const navs = [
  ["ask", "Ask / Search", "consumer"],
  ["history", "Conversation History", "consumer"],
  ["sources", "Sources", "consumer"],
  ["upload", "Upload Documents", "admin"],
  ["manage", "Manage RAG Documents", "admin"],
  ["evaluation", "Evaluation", "evaluator"],
  ["observability", "Observability", "ops"],
  ["guide", "Simulator guide", "consumer"]
];

function route(nextPage) {
  if (busy) {
    toast("Please wait for the current operation to finish.");
    return;
  }

  page = nextPage;
  pageNo = 1;
  listQuery = "";
  listState = "";

  if (location.hash !== "#" + nextPage) {
    location.hash = nextPage;
  } else {
    render();
  }
}

function render() {
  const selected = navs.find(item => item[0] === page);

  $("#nav").innerHTML = navs
    .filter(item => can(item[2]))
    .map(item => `
      <button
        data-page="${item[0]}"
        ${page === item[0] ? 'aria-current="page"' : ""}
      >${item[1]}</button>
    `).join("");

  if (!selected) {
    $("#main").innerHTML = heading(
      "Page not found",
      "Choose a page from the navigation."
    );
    return;
  }

  if (!can(selected[2])) {
    $("#main").innerHTML = heading(
      "Access denied",
      "This page is unavailable for the selected preview role."
    ) + `
      <div class="notice warn">
        A production backend must enforce this as HTTP 403.
        This static simulator only demonstrates the interface.
      </div>
    `;
    return;
  }

  ({
    ask: renderAsk,
    history: renderHistory,
    sources: renderSources,
    upload: renderUpload,
    manage: renderManage,
    evaluation: renderEvaluation,
    observability: renderObservability,
    guide: renderGuide
  })[page]();
}

function heading(title, subtitle) {
  return `
    <div class="heading">
      <div class="eyebrow">Product Knowledge Copilot</div>
      <h1>${title}</h1>
      <p style="margin-top:13px">${subtitle}</p>
    </div>
  `;
}

function empty(title, subtitle, action = "") {
  return `
    <div class="card empty">
      <div class="mark" aria-hidden="true">◇</div>
      <h2>${title}</h2>
      <p class="muted">${subtitle}</p>
      ${action}
    </div>
  `;
}

function sampleButton() {
  return `
    <button
      class="primary"
      data-action="demo"
      ${state.demo ? "disabled" : ""}
    >
      ${state.demo
        ? "Fictional examples loaded"
        : "Load fictional examples"}
    </button>
  `;
}

function filtersHTML() {
  return metaFields.map(([key, label]) => {
    const values = [
      ...new Set(
        state.docs
          .filter(eligible)
          .map(document => document[key])
          .filter(Boolean)
      )
    ].sort();

    return `
      <label>
        ${label}
        <select data-filter="${key}">
          <option value="">All</option>
          ${values.map(value => `
            <option
              ${filter[key] === value ? "selected" : ""}
              value="${esc(value)}"
            >${esc(value)}</option>
          `).join("")}
        </select>
      </label>
    `;
  }).join("");
}

function renderAsk() {
  const available = state.docs.filter(eligible).length;

  $("#main").innerHTML =
    heading(
      "Find the knowledge behind your next decision.",
      "Explore feature behaviour, related functionality and historical information from approved sources."
    ) +
    `
      <div class="notice">
        <strong>Simulator:</strong>
        answers quote matching source passages. No AI model is connected.
        ${state.demo
          ? "The example documents are fictional and are not product facts."
          : "Start with your own test text or load clearly labelled fictional examples."}
      </div>
    ` +
    (
      !state.docs.length
        ? empty(
            "Your knowledge space is empty",
            "Load examples to explore, or select Uploader / Admin to add a test document.",
            sampleButton()
          )
        : !available
          ? `
            <div class="notice warn">
              No approved sources are available.
              Use the Evaluator / Approver role to review processed documents.
            </div>
          `
          : ""
    ) +
    `
      <form id="askForm" class="card">
        <label for="question">Ask a question</label>
        <textarea
          id="question"
          maxlength="2000"
          placeholder="Ask about a feature, requirement, current behaviour, related functionality or previous release..."
          required
